<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sitenetsoft.quarkus</groupId>
    <artifactId>quarkus-atproto-lexicons-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>atproto-lexicons-standard-site</artifactId>
  <name>AT Protocol - Standard.site Lexicons</name>
  <description>site.standard.* lexicon pack with generated types.</description>
  <dependencies>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-syntax</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-atproto-lexicon</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-xrpc-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-lexicons-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!--
          Sets the property org.sitenetsoft.quarkus:atproto-lexicons-core:jar to the core pack as this build resolved
          it: the installed jar, the reactor's packaged jar, or core's target/classes when the reactor stops before
          package. The generator reads core's index.json from any of the three, so Standard.site refs to com.atproto
          defs resolve to the core pack's classes instead of being generated again.
        -->
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>locate-core-pack</id>
            <phase>initialize</phase>
            <goals><goal>properties</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-lexicon-classes</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>--lexicons</argument><argument>${lexicon.source.dir}</argument>
                <argument>--out</argument><argument>${lexicon.generated.sources}</argument>
                <argument>--index</argument><argument>${lexicon.index}</argument>
                <argument>--dependency-index</argument><argument>${org.sitenetsoft.quarkus:atproto-lexicons-core:jar}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.self="override"/>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables combine.self="override"/>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
