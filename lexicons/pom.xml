<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sitenetsoft.quarkus</groupId>
    <artifactId>quarkus-atproto-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>quarkus-atproto-lexicons-parent</artifactId>
  <packaging>pom</packaging>
  <name>Quarkus AT Protocol Lexicons - Parent</name>
  <modules>
    <module>core</module>
    <module>standard-site</module>
  </modules>
  <properties>
    <!-- A pack's Lexicon JSON (shipped as is) and where the classes and index generated from it go. -->
    <lexicon.source.dir>${project.basedir}/src/main/resources/META-INF/atproto/lexicons</lexicon.source.dir>
    <lexicon.generated.sources>${project.build.directory}/generated-sources/lexicon</lexicon.generated.sources>
    <lexicon.generated.resources>${project.build.directory}/generated-resources/lexicon</lexicon.generated.resources>
    <lexicon.index>${lexicon.generated.resources}/META-INF/atproto/lexicons/index.json</lexicon.index>
  </properties>
  <build>
    <pluginManagement>
      <plugins>
        <!--
          Runs the generator's Cli in generate-sources. The generator is a plugin dependency, not a dependency of the
          pack, so it never reaches the pack's consumers. Packs declare the execution with their own arguments
          (paths absolute: exec:java runs in Maven's JVM, whose working directory is wherever mvn was started).
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <configuration>
            <mainClass>org.sitenetsoft.atproto.lexicon.codegen.Cli</mainClass>
            <includeProjectDependencies>false</includeProjectDependencies>
            <includePluginDependencies>true</includePluginDependencies>
            <cleanupDaemonThreads>false</cleanupDaemonThreads>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.sitenetsoft.quarkus</groupId>
              <artifactId>atproto-lexicon-codegen</artifactId>
              <version>${project.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-lexicon-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${lexicon.generated.sources}</source></sources>
            </configuration>
          </execution>
          <execution>
            <id>add-lexicon-index</id>
            <phase>generate-resources</phase>
            <goals><goal>add-resource</goal></goals>
            <configuration>
              <resources><resource><directory>${lexicon.generated.resources}</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
