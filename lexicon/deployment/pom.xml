<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sitenetsoft.quarkus</groupId>
    <artifactId>quarkus-atproto-lexicon-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>quarkus-atproto-lexicon-deployment</artifactId>
  <name>Quarkus AT Protocol Lexicon - Deployment</name>
  <dependencies>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-atproto-lexicon</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-core-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-jackson-deployment</artifactId></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-lexicon-codegen</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit5-internal</artifactId><scope>test</scope></dependency>
    <!-- Lexicon packs for the registry, validator and codegen tests (the packs depend on the runtime module only). -->
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-lexicons-core</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-lexicons-standard-site</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <!-- the app Lexicon used by AppCodegenTest (as the CodeGenProvider input) and the validator tests -->
      <testResource><directory>src/test/lexicons</directory><targetPath>lexicons</targetPath></testResource>
      <!-- real Standard.site records committed with the pack (source and fetch date in its README) -->
      <testResource><directory>${project.basedir}/../../lexicons/standard-site/src/test/resources/records</directory><targetPath>records</targetPath></testResource>
    </testResources>
    <plugins>
      <plugin><artifactId>maven-compiler-plugin</artifactId></plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
