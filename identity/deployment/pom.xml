<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sitenetsoft.quarkus</groupId>
    <artifactId>quarkus-atproto-identity-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>quarkus-atproto-identity-deployment</artifactId>
  <name>Quarkus AT Protocol Identity - Deployment</name>
  <dependencies>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-atproto-identity</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-core-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-vertx-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-vertx-http-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-jackson-deployment</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-caffeine-deployment</artifactId></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-did-deployment</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-safe-fetch-deployment</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit5-internal</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><artifactId>maven-compiler-plugin</artifactId></plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables combine.children="append">
            <!-- tests replace DNS with a map; keeps Netty from probing (and WARNing about) the host's resolv.conf -->
            <vertx.disableDnsResolver>true</vertx.disableDnsResolver>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
